---
import Wordmark from './brand/Wordmark.astro';
import ThemeToggle from './ThemeToggle.astro';
import { primaryNav } from '../data/navigation';
import { withBase, isActive } from '../utils/url';

const pathname = Astro.url.pathname;
---

<header class="site-header" data-header>
  <div class="site-header__bar">
    <a class="site-header__brand" href={withBase('/')} aria-label="ISRO concept redesign, home">
      <Wordmark variant="full" height={22} />
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul role="list" class="site-header__list">
        {
          primaryNav.map((group) => (
            <li class="site-header__item" data-nav-item>
              <a
                class="site-header__link"
                href={withBase(group.href)}
                aria-current={isActive(group.href, pathname) ? 'page' : undefined}
              >
                {group.label}
              </a>

              <div class="mega" data-mega>
                <div class="mega__inner">
                  <p class="mega__blurb">{group.blurb}</p>
                  <ul role="list" class="mega__list">
                    {group.links.map((link) => (
                      <li>
                        <a
                          class="mega__link"
                          href={link.external ? link.href : withBase(link.href)}
                          rel={link.external ? 'noreferrer' : undefined}
                          target={link.external ? '_blank' : undefined}
                        >
                          <span>{link.label}</span>
                          {link.external && <span class="mega__ext" aria-hidden="true">↗</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <ThemeToggle />
      <a class="site-header__live" href={withBase('/newsroom')} aria-label="Watch Live (no stream active)">
        <span class="site-header__pulse" aria-hidden="true"></span>
        Watch Live
      </a>
      <button class="site-header__toggle" type="button" aria-expanded="false" data-menu-toggle>
        <span class="u-visually-hidden">Menu</span>
        <span class="site-header__bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div class="site-header__drawer" data-drawer hidden>
    <div class="site-header__drawer-inner">
      {
        primaryNav.map((group) => (
          <section class="drawer-group">
            <h2 class="drawer-group__title">{group.label}</h2>
            <ul role="list">
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.external ? link.href : withBase(link.href)}
                    rel={link.external ? 'noreferrer' : undefined}
                    target={link.external ? '_blank' : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
      <div class="site-header__drawer-theme">
        <ThemeToggle />
      </div>
      <a class="site-header__drawer-live" href={withBase('/newsroom')}>
        <span class="site-header__pulse" aria-hidden="true"></span>
        Watch Live
      </a>
    </div>
  </div>
</header>

<style lang="scss">
  @use 'mixins' as *;
  @use 'tokens' as *;
  @use 'sass:map';

  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: map.get($z, 'header');
    border-bottom: 1px solid transparent;
    background: transparent;
    transition:
      transform $dur-slow $ease-out-quart,
      border-color 800ms $ease-in-out-quint;

    /* Frost plate — always present so blur/opacity can ease instead of popping on */
    &::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background: rgb(4 6 10 / 0%);
      backdrop-filter: blur(0) saturate(100%);
      -webkit-backdrop-filter: blur(0) saturate(100%);
      transition:
        background-color 900ms $ease-in-out-quint,
        backdrop-filter 900ms $ease-in-out-quint,
        -webkit-backdrop-filter 900ms $ease-in-out-quint;
    }

    /* Soft top wash at rest — fades out as the frost takes over */
    &::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background: linear-gradient(to bottom, rgb(4 6 10 / 72%), transparent 85%);
      opacity: 1;
      transition: opacity 900ms $ease-in-out-quint;
    }

    &[data-pinned='false'] {
      transform: translateY(-100%);
    }

    &[data-scrolled='true'] {
      border-bottom-color: var(--line);

      &::before {
        background: rgb(4 6 10 / 72%);
        backdrop-filter: blur(22px) saturate(160%);
        -webkit-backdrop-filter: blur(22px) saturate(160%);
      }

      &::after {
        opacity: 0;
      }
    }
  }

  .site-header__bar,
  .site-header__drawer {
    position: relative;
    z-index: 1;
  }

  .site-header__bar {
    @include shell;

    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: var(--header-h);
    min-width: 0;

    @include from('lg') {
      gap: clamp(1rem, 3vw, 3rem);
    }
  }

  .site-header__brand {
    @include focus-ring;
    margin-right: auto;
    min-width: 0;
    flex: 1 1 auto;
    max-width: calc(100% - 6.5rem);

    @include from('lg') {
      flex: 0 1 auto;
      max-width: none;
    }

    :global(.wordmark) {
      max-width: 100%;
    }

    :global(.wordmark__logo) {
      max-width: 100%;
      height: auto !important;
    }
  }

  .site-header__nav {
    display: none;

    @include from('lg') {
      display: block;
      margin-inline: auto;
    }
  }

  .site-header__list {
    display: flex;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__item {
    position: relative;

    &:hover .mega,
    &:focus-within .mega {
      opacity: 1;
      visibility: visible;
      transform: translate(-50%, 0);
      pointer-events: auto;
    }
  }

  .site-header__link {
    @include focus-ring;

    display: block;
    padding: 0.6rem 0.9rem;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--ink-2);
    border-radius: var(--radius);
    transition: color $dur-fast ease;

    &[aria-current='page'] {
      color: var(--ink);
    }

    @include hover {
      color: var(--ink);
    }
  }

  .mega {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 50%;
    transform: translate(-50%, -8px);
    width: min(30rem, 78vw);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity $dur-base ease,
      transform $dur-base $ease-out-quart,
      visibility $dur-base;
  }

  .mega__inner {
    background: rgb(10 14 21 / 96%);
    backdrop-filter: blur(20px);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    box-shadow: 0 24px 60px -20px rgb(0 0 0 / 80%);
  }

  .mega__blurb {
    @include eyebrow;
    text-transform: none;
    letter-spacing: 0.01em;
    font-size: 0.75rem;
    margin-bottom: 0.9rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--line);
  }

  .mega__list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.15rem 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mega__link {
    @include focus-ring(2px);

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.4rem 0.5rem;
    margin-inline: -0.5rem;
    font-size: 0.8125rem;
    color: var(--ink-2);
    border-radius: var(--radius);
    transition:
      color $dur-fast ease,
      background-color $dur-fast ease;

    @include hover {
      color: var(--ink);
      background: var(--surface-2);
    }
  }

  .mega__ext {
    color: var(--ink-3);
    font-size: 0.7rem;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: none;
  }

  .site-header__actions :global(.theme-toggle__label) {
    @include upto('md') {
      display: none;
    }
  }

  .site-header__drawer-theme {
    grid-column: 1 / -1;
  }

  .site-header__live {
    @include focus-ring;

    display: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    transition:
      border-color $dur-fast ease,
      background-color $dur-fast ease;
    white-space: nowrap;

    @include from('lg') {
      display: inline-flex;
    }

    @include hover {
      border-color: #e11d2e;
      background: rgb(225 29 46 / 10%);
    }
  }

  .site-header__pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #e11d2e;
    box-shadow: 0 0 0 0 rgb(225 29 46 / 70%);
    animation: pulse 2.4s infinite;
  }

  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 9px rgb(225 29 46 / 0%);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(225 29 46 / 0%);
    }
  }

  .site-header__toggle {
    @include focus-ring;

    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);

    @include from('lg') {
      display: none;
    }
  }

  .site-header__bars {
    position: relative;
    display: block;
    width: 17px;
    height: 1.5px;
    background: var(--ink);
    transition: background-color $dur-fast ease;

    &::before,
    &::after {
      content: '';
      position: absolute;
      left: 0;
      width: 100%;
      height: 1.5px;
      background: var(--ink);
      transition: transform $dur-base $ease-out-quart;
    }

    &::before {
      top: -5.5px;
    }
    &::after {
      top: 5.5px;
    }
  }

  [aria-expanded='true'] .site-header__bars {
    background: transparent;

    &::before {
      transform: translateY(5.5px) rotate(45deg);
    }
    &::after {
      transform: translateY(-5.5px) rotate(-45deg);
    }
  }

  .site-header__drawer {
    max-height: calc(100svh - var(--header-h));
    overflow-y: auto;
    overscroll-behavior: contain;
    background: color-mix(in srgb, var(--void) 96%, transparent);
    backdrop-filter: blur(20px);
    border-top: 1px solid var(--line);

    &[hidden] {
      display: none;
    }

    @include from('lg') {
      display: none;
    }
  }

  .site-header__drawer-inner {
    @include shell;

    display: grid;
    gap: 1.75rem;
    padding-block: 1.5rem 2.5rem;

    @include from('sm') {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      padding-block: 2rem 3rem;
    }
  }

  .drawer-group__title {
    @include eyebrow;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  .drawer-group ul {
    display: grid;
    gap: 0.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .drawer-group a {
    @include focus-ring(2px);
    display: block;
    padding: 0.45rem 0;
    font-size: 0.9375rem;
    color: var(--ink-2);
    border-bottom: 1px solid var(--line);
  }

  .site-header__drawer-live {
    @include focus-ring;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    padding: 0.75rem 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
    border: 1px solid var(--line-strong);
    border-radius: 999px;

    @include from('sm') {
      grid-column: 1 / -1;
      justify-self: start;
    }

    @include from('lg') {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const drawer = document.querySelector<HTMLElement>('[data-drawer]');

  const setMenuOpen = (open: boolean) => {
    if (!toggle || !drawer) return;
    toggle.setAttribute('aria-expanded', String(open));
    drawer.hidden = !open;
    document.body.style.overflow = open ? 'hidden' : '';
  };

  if (toggle && drawer) {
    toggle.setAttribute('aria-controls', 'site-menu');
    drawer.id = 'site-menu';

    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      setMenuOpen(!open);
    });

    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMenuOpen(false));
    });

    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setMenuOpen(false);
        toggle.focus();
      }
    });
  }

  if (header) {
    // Hide on scroll down, reveal on scroll up — but never while the mobile
    // drawer is open, which would strand the close button off-screen.
    let last = window.scrollY;

    const onScroll = () => {
      const y = window.scrollY;
      header.dataset.scrolled = String(y > 24);

      const drawerOpen = drawer && !drawer.hidden;
      const goingDown = y > last && y > 220;
      header.dataset.pinned = String(!goingDown || Boolean(drawerOpen));

      last = y;
    };

    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
