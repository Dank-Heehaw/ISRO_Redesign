---
import { withBase } from '../../utils/url';
---

<section class="hero">
  <div class="hero__media" aria-hidden="true">
    <canvas class="hero__stars" data-starfield></canvas>
    <div class="hero__limb" data-parallax="0.08"></div>
    <div class="hero__glow"></div>
    <div class="hero__grid"></div>
  </div>

  <div class="hero__inner">
    <p class="hero__eyebrow deva" data-anim="fade" data-anim-start="top 100%">
      भारतीय अंतरिक्ष अनुसंधान संगठन
    </p>

    <h1 class="hero__title" data-anim="split-lines" data-anim-start="top 100%">
      Reaching outward,<br />from here.
    </h1>

    <p class="hero__lede" data-anim="fade-up" data-anim-delay="0.3" data-anim-start="top 100%">
      Launch vehicles, planetary probes, and Earth-observation systems that underpin weather,
      navigation, and communications across India.
    </p>

    <div class="hero__actions" data-anim="fade-up" data-anim-delay="0.45" data-anim-start="top 100%">
      <a class="btn btn--primary" href={withBase('/missions')}>
        Explore missions
        <span aria-hidden="true">→</span>
      </a>
      <a class="btn btn--ghost" href={withBase('/launch-vehicles')}>The fleet</a>
    </div>
  </div>

  <a class="hero__scroll" href="#next-launch" aria-label="Scroll to next launch">
    <span class="mono">Scroll</span>
    <span class="hero__scroll-line" aria-hidden="true"></span>
  </a>
</section>

<style lang="scss">
  @use 'mixins' as *;
  @use 'tokens' as *;

  .hero {
    position: relative;
    display: grid;
    align-items: end;
    justify-items: stretch;
    min-height: 100svh;
    min-height: 100dvh;
    padding-block: calc(var(--header-h) + clamp(1.5rem, 4vw, 3rem)) clamp(5rem, 10vw, 7rem);
    overflow: clip;
    isolation: isolate;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__stars {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero__limb {
    position: absolute;
    top: auto;
    bottom: -42vw;
    left: 50%;
    width: 160vw;
    height: 160vw;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 0%, #101c2e 0%, #070b14 38%, #04060a 58%, transparent 68%);
    box-shadow:
      inset 0 10px 28px rgb(94 176 255 / 22%),
      0 -2px 100px rgb(94 176 255 / 12%),
      0 -8px 180px rgb(255 107 18 / 10%);
    filter: blur(14px);
    opacity: 0.72;

    @include from('md') {
      bottom: -36vw;
      width: 140vw;
      height: 140vw;
      filter: blur(18px);
    }
  }

  .hero__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(42rem 28rem at 50% 42%, rgb(94 176 255 / 8%), transparent 68%),
      radial-gradient(36rem 24rem at 28% 22%, rgb(255 107 18 / 8%), transparent 62%),
      radial-gradient(34rem 22rem at 72% 18%, rgb(94 176 255 / 6%), transparent 60%);
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 4%) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 4%) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(58% 52% at 50% 46%, #000 0%, transparent 100%);
  }

  .hero__inner {
    @include shell;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-self: stretch;
    width: 100%;
    text-align: left;
  }

  .hero__eyebrow,
  .hero__title,
  .hero__lede {
    text-align: left;
    margin-inline: 0;
  }

  .hero__eyebrow {
    font-size: clamp(0.875rem, 1.4vw, 1.05rem);
    letter-spacing: 0.02em;
    color: #ff9a4d;
    margin-bottom: clamp(1rem, 2vw, 1.75rem);
  }

  .hero__title {
    font-size: var(--step-6);
    font-weight: 600;
    // Loose enough that G / commas aren't shaved by the split-line mask.
    letter-spacing: -0.03em;
    line-height: 1.08;
    max-width: 14ch;
    overflow: visible;

    :global(.split-line-wrap),
    :global(.split-line) {
      text-align: left;
    }
  }

  .hero__lede {
    margin-top: clamp(1.25rem, 2.5vw, 2rem);
    max-width: 40ch;
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--ink-2);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 0.75rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .btn {
    @include focus-ring;

    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.95rem 1.65rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    border-radius: 999px;
    transition:
      background-color $dur-base ease,
      border-color $dur-base ease,
      color $dur-base ease,
      transform $dur-base $ease-out-quart;

    span {
      transition: transform $dur-base $ease-out-quart;
    }

    @include hover {
      transform: translateY(-2px);

      span {
        transform: translateX(4px);
      }
    }
  }

  .btn--primary {
    background: var(--accent);
    color: #041018;
    border: 1px solid var(--accent);

    @include hover {
      background: var(--accent-lit);
      border-color: var(--accent-lit);
    }
  }

  .btn--ghost {
    color: var(--ink);
    border: 1px solid var(--line-strong);

    @include hover {
      border-color: var(--ink-2);
      background: rgb(255 255 255 / 5%);
    }
  }

  .hero__scroll {
    @include focus-ring;

    position: absolute;
    right: var(--gutter);
    bottom: clamp(2rem, 5vw, 4rem);
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-3);
    writing-mode: vertical-rl;

    @include from('lg') {
      display: flex;
    }
  }

  .hero__scroll-line {
    width: 1px;
    height: 62px;
    background: linear-gradient(to bottom, var(--line-strong), transparent);
    position: relative;
    overflow: clip;

    &::after {
      content: '';
      position: absolute;
      inset: 0 auto auto 0;
      width: 1px;
      height: 22px;
      background: #ff6b12;
      animation: trace 2.6s $ease-in-out-quint infinite;
    }
  }

  @keyframes trace {
    0% {
      transform: translateY(-24px);
    }
    100% {
      transform: translateY(62px);
    }
  }

  @include reduced-motion {
    .hero__scroll-line::after {
      animation: none;
    }
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-starfield]');
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const stars: { x: number; y: number; r: number; a: number; drift: number }[] = [];
    let raf = 0;

    const build = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const { width, height } = canvas.getBoundingClientRect();

      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const count = Math.round((width * height) / 5200);
      stars.length = 0;

      for (let i = 0; i < count; i++) {
        stars.push({
          x: Math.random() * width,
          y: Math.random() * height,
          r: Math.random() * 1.1 + 0.25,
          a: Math.random() * 0.55 + 0.12,
          drift: Math.random() * 0.6 + 0.2,
        });
      }
    };

    const draw = (t: number) => {
      const { width, height } = canvas.getBoundingClientRect();
      ctx.clearRect(0, 0, width, height);

      for (const s of stars) {
        const twinkle = reduced ? 1 : 0.65 + 0.35 * Math.sin(t * 0.0012 * s.drift + s.x);
        ctx.globalAlpha = s.a * twinkle;
        ctx.fillStyle = '#dce8f5';
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
        ctx.fill();
      }

      ctx.globalAlpha = 1;
      if (!reduced) raf = requestAnimationFrame(draw);
    };

    build();
    draw(0);

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        cancelAnimationFrame(raf);
        build();
        draw(0);
      }, 180);
    });
  }
</script>
