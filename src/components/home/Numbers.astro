---
// Indicative homepage tallies — prefer conservative, publicly cited figures.
const figures = [
  { value: 132, suffix: '', label: 'Spacecraft missions', note: 'Since Aryabhata, 1975' },
  { value: 105, suffix: '', label: 'Launch missions', note: 'Through PSLV-C62, Jan 2026' },
  { value: 434, suffix: '', label: 'Foreign satellites launched', note: 'For 36 countries' },
  { value: 57, suffix: '', label: 'Years of operations', note: 'Established 1969' },
];
---

<section class="numbers">
  <div class="numbers__inner">
    {
      figures.map((f, i) => (
        <div class="figure" data-anim="fade-up" data-anim-delay={i * 0.08}>
          <p class="figure__value">
            <span class="mono" data-counter={f.value}>
              0
            </span>
            {f.suffix}
          </p>
          <p class="figure__label">{f.label}</p>
          <p class="figure__note">{f.note}</p>
        </div>
      ))
    }
  </div>
</section>

<style lang="scss">
  @use 'mixins' as *;

  .numbers {
    border-block: 1px solid var(--line);
    background: var(--surface);
  }

  .numbers__inner {
    @include shell;

    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3rem);
    padding-block: clamp(3rem, 6vw, 5.5rem);

    @include from('lg') {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .figure__value {
    font-family: var(--font-display);
    font-size: var(--step-5);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--ink);
    background: linear-gradient(180deg, var(--ink) 20%, var(--accent) 190%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .figure__label {
    margin-top: 0.9rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink);
  }

  .figure__note {
    @include eyebrow;
    margin-top: 0.35rem;
  }
</style>
