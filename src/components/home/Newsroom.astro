---
import { getCollection } from 'astro:content';
import SectionHeader from '../SectionHeader.astro';
import { withBase } from '../../utils/url';

const items = (await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);

const dateFmt = new Intl.DateTimeFormat('en-IN', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<section class="newsroom">
  <div class="newsroom__inner">
    <SectionHeader
      eyebrow="Newsroom"
      title="What happened this month."
      href="/newsroom"
      linkLabel="All updates"
    />

    <ul role="list" class="newsroom__list">
      {
        items.map((item) => (
          <li data-anim="fade-up">
            <a class="entry" href={withBase(`/newsroom/${item.id}`)}>
              <time class="entry__date mono" datetime={item.data.date.toISOString()}>
                {dateFmt.format(item.data.date)}
              </time>
              <span class="entry__type">{item.data.type}</span>
              <span class="entry__text">
                <span class="entry__title">{item.data.title}</span>
                <span class="entry__summary">{item.data.summary}</span>
              </span>
              <span class="entry__arrow" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style lang="scss">
  @use 'mixins' as *;
  @use 'tokens' as *;

  .newsroom {
    padding-block: var(--section-y);
  }

  .newsroom__inner {
    @include shell;
  }

  .newsroom__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .entry {
    @include focus-ring(-2px);

    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.5rem 2rem;
    padding-block: clamp(1.25rem, 2.5vw, 1.9rem);
    border-bottom: 1px solid var(--line);
    transition: background-color $dur-fast ease;

    @include from('lg') {
      grid-template-columns: 8rem 7rem 1fr 2rem;
      align-items: baseline;
    }

    @include hover {
      background: linear-gradient(90deg, rgb(94 176 255 / 6%), transparent 60%);

      .entry__title {
        color: var(--accent-lit);
      }

      .entry__arrow {
        transform: translateX(5px);
        color: var(--accent);
      }
    }
  }

  .entry__date {
    font-size: 0.75rem;
    color: var(--ink-3);
    white-space: nowrap;
  }

  .entry__type {
    @include eyebrow;
    color: var(--azure);
    justify-self: end;

    @include from('lg') {
      justify-self: start;
    }
  }

  .entry__text {
    grid-column: 1 / -1;
    display: grid;
    gap: 0.4rem;

    @include from('lg') {
      grid-column: auto;
    }
  }

  .entry__title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--ink);
    text-wrap: balance;
    transition: color $dur-fast ease;
  }

  .entry__summary {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--ink-3);
    max-width: 62ch;
  }

  .entry__arrow {
    display: none;
    color: var(--ink-3);
    transition:
      transform $dur-base $ease-out-quart,
      color $dur-base ease;

    @include from('lg') {
      display: block;
      justify-self: end;
    }
  }
</style>
