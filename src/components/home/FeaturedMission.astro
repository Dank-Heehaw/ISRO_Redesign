---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../../utils/url';

interface Props {
  mission: CollectionEntry<'missions'>;
}

const { mission } = Astro.props;
const { name, summary, stats, accent, destination, vehicle } = mission.data;

const sketchfabId = '962a218eb4394890bfa55ab1e6b233e7';
const sketchfabSrc = new URL(`https://sketchfab.com/models/${sketchfabId}/embed`);
sketchfabSrc.searchParams.set('autostart', '1');
sketchfabSrc.searchParams.set('ui_theme', 'dark');
sketchfabSrc.searchParams.set('transparent', '1');
sketchfabSrc.searchParams.set('ui_hint', '0');
sketchfabSrc.searchParams.set('ui_infos', '0');
sketchfabSrc.searchParams.set('ui_controls', '1');
sketchfabSrc.searchParams.set('ui_stop', '0');
sketchfabSrc.searchParams.set('dnt', '1');
---

<section class="featured" style={`--accent: ${accent}`} data-featured>
  <div class="featured__viz">
    <svg class="featured__grid" viewBox="0 0 280 360" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <pattern id="bp-grid" width="14" height="14" patternUnits="userSpaceOnUse">
          <path d="M14 0H0V14" stroke="currentColor" stroke-width="0.4" opacity="0.35" />
        </pattern>
        <radialGradient id="bp-fade" cx="50%" cy="48%" r="58%">
          <stop offset="0%" stop-color="#fff" stop-opacity="1"></stop>
          <stop offset="72%" stop-color="#fff" stop-opacity="0.5"></stop>
          <stop offset="100%" stop-color="#fff" stop-opacity="0"></stop>
        </radialGradient>
        <mask id="bp-mask">
          <rect width="280" height="360" fill="url(#bp-fade)"></rect>
        </mask>
      </defs>
      <rect width="280" height="360" fill="url(#bp-grid)" mask="url(#bp-mask)"></rect>
    </svg>

    <div class="featured__model">
      <iframe
        title="ISRO Gaganyaan 3D model by the3dCartel on Sketchfab"
        src={sketchfabSrc.href}
        allow="autoplay; fullscreen; xr-spatial-tracking"
        allowfullscreen
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
      >
      </iframe>
    </div>
  </div>

  <div class="featured__content">
    <div class="featured__intro">
      <p class="eyebrow" data-anim="fade-up">Mission in focus</p>
      <h2 class="featured__title" data-anim="split-lines">{name}</h2>
      <p class="lede" data-anim="fade-up" data-anim-delay="0.1">{summary}</p>
      <a class="featured__cta" href={withBase(`/missions/${mission.id}`)} data-anim="fade-up" data-anim-delay="0.2">
        Mission profile <span aria-hidden="true">→</span>
      </a>
    </div>

    <dl class="featured__stats">
      <div class="featured__stat" data-anim="fade-up">
        <dt>Destination</dt>
        <dd>{destination}</dd>
      </div>
      {
        vehicle && (
          <div class="featured__stat" data-anim="fade-up" data-anim-delay="0.05">
            <dt>Vehicle</dt>
            <dd>{vehicle}</dd>
          </div>
        )
      }
      {
        stats.map((stat, i) => (
          <div class="featured__stat" data-anim="fade-up" data-anim-delay={0.1 + i * 0.05}>
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style lang="scss">
  @use 'mixins' as *;
  @use 'tokens' as *;

  .featured {
    position: relative;
    padding-block: var(--section-y);
    background:
      radial-gradient(70rem 44rem at 20% 40%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 70%),
      var(--void);

    @include from('lg') {
      @include shell;
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.9fr);
      gap: clamp(1.5rem, 3vw, 3rem);
      // Both columns share one row — content height drives the embed height.
      align-items: stretch;
    }
  }

  .featured__viz {
    position: relative;
    // Mobile: keep a readable stage size.
    min-height: min(88vw, 26rem);
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);

    @include from('lg') {
      // Stretch to match the text column (eyebrow → stats grid).
      margin-bottom: 0;
      min-height: 0;
      height: 100%;
      align-self: stretch;
    }
  }

  .featured__model {
    position: absolute;
    // Fill the same band as the content: top of "Mission in focus" → bottom of stats.
    inset: 0;
    z-index: 1;
    padding-inline: clamp(1rem, 4vw, 2.5rem);
    background: transparent;
    border-radius: 14px;
    overflow: clip;
    box-sizing: border-box;

    iframe {
      width: 100%;
      height: 100%;
      border: 0;
      background: transparent;
      border-radius: inherit;
    }
  }

  .featured__grid {
    position: absolute;
    inset: 0;
    width: auto;
    height: auto;
    color: var(--ink-3);
    pointer-events: none;
    z-index: 0;
    border-radius: 14px;
    overflow: clip;
  }

  .featured__content {
    @include shell;

    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);

    @include from('lg') {
      // Natural height — this is what sizes the embed column.
      max-width: 38rem;
      padding-inline: 0;
      margin: 0;
      width: 100%;
    }
  }

  .featured__title {
    font-size: var(--step-5);
    margin-block: 0.75rem 1.25rem;
  }

  .featured__cta {
    @include focus-ring;

    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.75rem;
    padding-bottom: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    border-bottom: 1px solid var(--accent);

    span {
      transition: transform $dur-base $ease-out-quart;
    }

    @include hover {
      span {
        transform: translateX(5px);
      }
    }
  }

  .featured__stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 1px;
    margin: 0;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: clip;
  }

  .featured__stat {
    padding: 1.1rem 1.25rem;
    background: var(--surface);

    dt {
      @include eyebrow;
      margin-bottom: 0.4rem;
    }

    dd {
      margin: 0;
      font-family: var(--font-display);
      font-size: 1.0625rem;
      font-weight: 600;
      letter-spacing: -0.02em;
      color: var(--ink);
    }
  }
</style>
