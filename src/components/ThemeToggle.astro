---
/**
 * ThemeToggle: switches between the custom redesign and the UX4G government
 * design-system look (https://www.ux4g.gov.in/?lang=en). Preference in localStorage.
 * Chrome always matches the UX4G control style so size/shape stay stable across themes.
 */
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-pressed="false"
  aria-label="Switch to UX4G government theme"
  title="Theme: Redesign / UX4G"
>
  <span class="theme-toggle__track" aria-hidden="true">
    <span class="theme-toggle__thumb"></span>
  </span>
  <span class="theme-toggle__label mono">
    <span data-theme-label>Redesign</span>
  </span>
</button>

<style lang="scss">
  @use 'mixins' as *;
  @use 'tokens' as *;

  // Fixed footprint — same in redesign + UX4G so the header never jumps.
  .theme-toggle {
    @include focus-ring;

    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.25rem;
    min-width: 7.75rem;
    padding: 0.4rem 0.7rem 0.4rem 0.55rem;
    border: 1px solid var(--line-strong);
    border-radius: 0.25rem;
    background: var(--surface, rgb(255 255 255 / 6%));
    color: var(--ink-2);
    cursor: pointer;
    font: inherit;
    transition:
      border-color $dur-fast ease,
      background-color $dur-fast ease,
      color $dur-fast ease,
      box-shadow $dur-fast ease;

    @include hover {
      border-color: var(--accent);
      color: var(--ink);
    }

    &[aria-pressed='true'] {
      border-color: #4a2bc2;
      background: color-mix(in srgb, #4a2bc2 10%, var(--surface, #fff));
      color: #301c7d;
      box-shadow: 0 0 0 3px rgb(74 43 194 / 18%);
    }
  }

  .theme-toggle__track {
    position: relative;
    width: 1.85rem;
    height: 1rem;
    flex: none;
    border-radius: 0.125rem;
    background: var(--surface-3, rgb(255 255 255 / 8%));
    border: 1px solid var(--line);
  }

  .theme-toggle__thumb {
    position: absolute;
    top: 1px;
    left: 1px;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 0.1rem;
    background: #4a2bc2;
    transition: transform $dur-base $ease-out-quart;
  }

  .theme-toggle[aria-pressed='true'] .theme-toggle__thumb {
    transform: translateX(0.75rem);
  }

  .theme-toggle__label {
    flex: 1 1 auto;
    min-width: 4.25rem;
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    text-align: left;
  }

  // Dark redesign canvas: keep the same geometry, just darker fill.
  :root:not([data-theme='ux4g']) .theme-toggle {
    background: rgb(255 255 255 / 8%);
    border-color: var(--line-strong);
    color: var(--ink-2);

    &[aria-pressed='true'] {
      color: #c0b3ff;
      background: color-mix(in srgb, #4a2bc2 28%, transparent);
      box-shadow: 0 0 0 3px rgb(74 43 194 / 28%);
    }
  }
</style>

<script>
  const STORAGE_KEY = 'isro-theme';
  const UX4G = 'ux4g';
  const REDESIGN = 'redesign';

  const root = document.documentElement;
  const buttons = () => document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');

  const read = (): string => {
    try {
      return localStorage.getItem(STORAGE_KEY) === UX4G ? UX4G : REDESIGN;
    } catch {
      return REDESIGN;
    }
  };

  const apply = (theme: string) => {
    const isUx = theme === UX4G;
    if (isUx) root.setAttribute('data-theme', UX4G);
    else root.removeAttribute('data-theme');

    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute('content', isUx ? '#fafafa' : '#04060a');

    buttons().forEach((btn) => {
      btn.setAttribute('aria-pressed', String(isUx));
      btn.setAttribute(
        'aria-label',
        isUx ? 'Switch to custom redesign theme' : 'Switch to UX4G government theme',
      );
      const label = btn.querySelector('[data-theme-label]');
      if (label) label.textContent = isUx ? 'UX4G' : 'Redesign';
    });
  };

  apply(read());

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    const btn = target?.closest?.('[data-theme-toggle]') as HTMLButtonElement | null;
    if (!btn) return;
    const next = read() === UX4G ? REDESIGN : UX4G;
    try {
      localStorage.setItem(STORAGE_KEY, next);
    } catch {
      /* ignore quota / private mode */
    }
    apply(next);
  });
</script>
