---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../utils/url';

interface Props {
  mission: CollectionEntry<'missions'>;
  /** `wide` spans two grid columns and shows the summary at larger type. */
  size?: 'default' | 'wide';
}

const { mission, size = 'default' } = Astro.props;
const { name, category, status, launchDate, destination, summary, accent } = mission.data;

const statusLabel: Record<string, string> = {
  operational: 'Operational',
  completed: 'Completed',
  'in-development': 'In development',
  upcoming: 'Upcoming',
};

const year = launchDate ? launchDate.getUTCFullYear() : '—';
---

<a
  class:list={['mission-card', `mission-card--${size}`]}
  href={withBase(`/missions/${mission.id}`)}
  style={`--accent: ${accent}`}
  data-anim="fade-up"
>
  <span class="mission-card__wash" aria-hidden="true"></span>

  <span class="mission-card__top">
    <span class="mission-card__year mono">{year}</span>
    <span class:list={['mission-card__status', `is-${status}`]}>{statusLabel[status]}</span>
  </span>

  <span class="mission-card__body">
    <h3 class="mission-card__name">{name}</h3>
    <span class="mission-card__destination mono">{destination}</span>
    <p class="mission-card__summary">{summary}</p>
  </span>

  <span class="mission-card__foot">
    <span class="mission-card__category">{category}</span>
    <span class="mission-card__arrow" aria-hidden="true">→</span>
  </span>
</a>

<style lang="scss">
  @use 'mixins' as *;
  @use 'tokens' as *;

  .mission-card {
    @include focus-ring;

    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    min-height: 20rem;
    padding: clamp(1.25rem, 2.4vw, 1.9rem);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: clip;
    isolation: isolate;
    transition:
      border-color $dur-base ease,
      transform $dur-base $ease-out-quart;

    @include hover {
      border-color: color-mix(in srgb, var(--accent) 55%, transparent);
      transform: translateY(-4px);

      .mission-card__wash {
        opacity: 1;
      }

      .mission-card__arrow {
        transform: translateX(5px);
        color: var(--accent);
      }
    }
  }

  .mission-card--wide {
    @include from('md') {
      grid-column: span 2;
      min-height: 22rem;
    }
  }

  .mission-card__wash {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.55;
    background:
      radial-gradient(28rem 18rem at 100% 0%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 70%),
      linear-gradient(180deg, transparent 40%, color-mix(in srgb, var(--accent) 7%, transparent));
    transition: opacity $dur-base ease;
  }

  .mission-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .mission-card__year {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--ink-3);
  }

  .mission-card__status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-2);

    &::before {
      content: '';
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: currentcolor;
    }

    &.is-operational {
      color: var(--status-active);
    }
    &.is-completed {
      color: var(--status-flown);
    }
    &.is-in-development,
    &.is-upcoming {
      color: var(--status-upcoming);
    }
  }

  .mission-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin-top: auto;
  }

  .mission-card__name {
    font-size: var(--step-2);
    letter-spacing: -0.03em;
  }

  .mission-card__destination {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .mission-card__summary {
    margin-top: 0.35rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--ink-2);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .mission-card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .mission-card__category {
    @include eyebrow;
  }

  .mission-card__arrow {
    color: var(--ink-3);
    transition:
      transform $dur-base $ease-out-quart,
      color $dur-base ease;
  }
</style>
