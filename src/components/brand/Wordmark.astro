---
/**
 * Official-style wordmark from the redesign assets (Swarna Manjari direction).
 * White fill — works on the dark canvas without the old orange delta mark.
 */
import { withBase } from '../../utils/url';

interface Props {
  /** `full` adds the Devanagari and English expansions beside the mark. */
  variant?: 'compact' | 'full';
  /** Height of the SVG wordmark in px. */
  height?: number;
  class?: string;
}

const { variant = 'compact', height = 28, class: className } = Astro.props;
const aspect = 311.74 / 113.52;
const width = Math.round(height * aspect);
---

<span class:list={['wordmark', `wordmark--${variant}`, className]}>
  <img
    class="wordmark__logo"
    src={withBase('/SVG/isro_White.svg')}
    width={width}
    height={height}
    alt="ISRO"
    decoding="async"
    style={`height: ${height}px; width: ${width}px`}
  />
  {
    variant === 'full' && (
      <span class="wordmark__expansion">
        <span class="deva">भारतीय अंतरिक्ष अनुसंधान संगठन</span>
        <span>Indian Space Research Organisation</span>
      </span>
    )
  }
</span>

<style lang="scss">
  @use 'mixins' as *;

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
  }

  .wordmark__logo {
    flex: none;
    display: block;
    object-fit: contain;
  }

  .wordmark__expansion {
    display: none;
    font-size: 0.625rem;
    line-height: 1.45;
    letter-spacing: 0.05em;
    color: var(--ink-3);

    @include from('lg') {
      display: flex;
      flex-direction: column;
      padding-left: 0.85rem;
      border-left: 1px solid var(--line-strong);
    }
  }
</style>
