---
/**
 * Concept mark for the redesign: an ascending delta whose flanks are drawn as
 * parabolas rather than straight edges, crossed by an inclined orbital ring.
 *
 * Original artwork. The parabolic-logotype direction is inspired by Swarna
 * Manjari's ISRO rebranding study — credited on /brand.
 */
interface Props {
  size?: number;
  /** Renders the ring in azure; disable for single-colour contexts. */
  ring?: boolean;
  class?: string;
}

const { size = 40, ring = true, class: className } = Astro.props;
const uid = Math.random().toString(36).slice(2, 9);
---

<svg
  class:list={['mark', className]}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  role="img"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={`delta-${uid}`} x1="24" y1="2" x2="24" y2="44" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="var(--saffron-lit)"></stop>
      <stop offset="0.62" stop-color="var(--saffron)"></stop>
      <stop offset="1" stop-color="var(--saffron-deep)"></stop>
    </linearGradient>
  </defs>

  {
    ring && (
      <ellipse
        class="mark__ring"
        cx="24"
        cy="27.5"
        rx="21"
        ry="8"
        transform="rotate(-21 24 27.5)"
        stroke="var(--azure)"
        stroke-width="1.6"
        opacity="0.65"
      />
    )
  }

  <path
    class="mark__delta"
    d="M24 2.5 Q27.6 21 38.6 43 L24 33.6 L9.4 43 Q20.4 21 24 2.5 Z"
    fill={`url(#delta-${uid})`}
  ></path>
</svg>

<style lang="scss">
  .mark {
    flex: none;
    overflow: visible;
  }

  .mark__ring,
  .mark__delta {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      transform 520ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 320ms ease;
  }

  :global(a:hover) .mark__delta,
  :global(a:focus-visible) .mark__delta {
    transform: translateY(-2px);
  }

  :global(a:hover) .mark__ring {
    opacity: 1;
    transform: rotate(12deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .mark__ring,
    .mark__delta {
      transition: none;
    }
  }
</style>
