---
/**
 * Bottom-left accessibility control. Content stays at full size; GSAP animates
 * a clipping frame (width + height together). Fine pointer + hover: expand on
 * hover/focus. Coarse/touch: tap-to-toggle (no hover reliance).
 */
import ThemeToggle from './ThemeToggle.astro';
---

<aside class="a11y-dock" data-a11y-dock aria-label="Accessibility options">
  <div
    class="a11y-dock__hit"
    data-a11y-hit
    role="button"
    tabindex="0"
    aria-expanded="false"
    aria-controls="a11y-dock-panel"
  >
    <span class="a11y-dock__peek mono" aria-hidden="true">A11y</span>
    <div class="a11y-dock__inner" data-a11y-inner id="a11y-dock-panel">
      <div class="a11y-dock__chrome">
        <p class="a11y-dock__eyebrow mono">A11y</p>
        <button type="button" class="a11y-dock__close mono" data-a11y-close hidden>
          Close
        </button>
      </div>
      <div class="a11y-dock__panel">
        <p class="a11y-dock__title">Theme</p>
        <p class="a11y-dock__hint">Switch between redesign and UX4G government look.</p>
        <ThemeToggle />
        <a
          class="a11y-dock__link"
          href="https://www.ux4g.gov.in/?lang=en"
          target="_blank"
          rel="noreferrer"
        >
          UX4G design system ↗
        </a>
      </div>
    </div>
  </div>
</aside>

<style lang="scss">
  @use 'mixins' as *;
  @use 'tokens' as *;
  @use 'sass:map';

  .a11y-dock {
    position: fixed;
    left: max(0.5rem, env(safe-area-inset-left));
    bottom: max(0.5rem, env(safe-area-inset-bottom));
    z-index: map.get($z, 'toast');
  }

  .a11y-dock__hit {
    position: relative;
    // `clip-path` is required: Chromium often fails to clip descendants when
    // `overflow: hidden` and `backdrop-filter` share the same element.
    overflow: hidden;
    clip-path: inset(0 round 0.25rem);
    box-sizing: border-box;
    border: 1px solid var(--line-strong);
    border-radius: 0.25rem;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    backdrop-filter: blur(10px);
    box-shadow: 0 2px 10px rgb(0 0 0 / 12%);
    // Collapsed fallback before JS measures (~3rem × 2.125rem chip).
    width: 3rem;
    height: 2.125rem;
    cursor: pointer;
  }

  // ~44px collapsed hit on touch / coarse pointer without enlarging desktop chip.
  @media (hover: none), (pointer: coarse) {
    .a11y-dock__hit {
      width: 2.75rem;
      height: 2.75rem;
      min-width: 2.75rem;
      min-height: 2.75rem;
    }
  }

  .a11y-dock__hit.is-open {
    border-color: var(--accent);
    box-shadow: 0 8px 24px rgb(0 0 0 / 18%);
    cursor: default;
  }

  // Short label chip while collapsed; opaque so panel never shows through.
  .a11y-dock__peek {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    padding: 0 0.35rem;
    pointer-events: none;
    opacity: 1;
    font-size: 0.5625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1;
    color: var(--ink-3);
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    backdrop-filter: blur(10px);
    transition: opacity 0.2s ease;
  }

  .a11y-dock__peek::before {
    content: '';
    flex: none;
    width: 0.2rem;
    height: 0.7rem;
    border-radius: 1px;
    background: var(--accent);
  }

  .a11y-dock__hit.is-open .a11y-dock__peek {
    opacity: 0;
  }

  .a11y-dock__inner {
    box-sizing: border-box;
    width: min(15rem, calc(100vw - 1rem));
    padding: 0.4rem 0.55rem;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.45rem;
  }

  .a11y-dock__chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-height: 1.15rem;
  }

  .a11y-dock__close {
    @include focus-ring(2px);

    flex: none;
    margin: 0;
    padding: 0.2rem 0.35rem;
    border: 0;
    border-radius: 0.15rem;
    background: transparent;
    color: var(--ink-3);
    font: inherit;
    font-size: 0.5625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    line-height: 1.2;
  }

  @media (hover: none), (pointer: coarse) {
    .a11y-dock__close {
      min-height: 2.75rem;
      min-width: 2.75rem;
      padding: 0.45rem 0.5rem;
    }
  }

  .a11y-dock__close:hover,
  .a11y-dock__close:focus-visible {
    color: var(--ink);
  }

  // Fully hide panel chrome only when sealed (fully collapsed, not mid-tween).
  .a11y-dock__hit.is-sealed .a11y-dock__panel,
  .a11y-dock__hit.is-sealed .a11y-dock__close {
    visibility: hidden;
    pointer-events: none;
  }

  .a11y-dock__hit.is-sealed .a11y-dock__eyebrow {
    visibility: hidden;
  }

  .a11y-dock__eyebrow {
    margin: 0;
    font-size: 0.5625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1.15;
    color: var(--ink-3);
    flex: none;
    white-space: nowrap;
    overflow: hidden;
    // Covered by peek while collapsed; readable in the open panel.
    max-width: 100%;
  }

  .a11y-dock__panel {
    display: grid;
    gap: 0.55rem;
    width: 100%;
  }

  .a11y-dock__title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .a11y-dock__hint {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--ink-3);
  }

  .a11y-dock__link {
    @include focus-ring(2px);

    font-size: 0.6875rem;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .a11y-dock :global(.theme-toggle) {
    min-width: 0;
    width: 100%;
    min-height: 2rem;
    padding: 0.3rem 0.45rem;
    gap: 0.4rem;
  }

  @media (hover: none), (pointer: coarse) {
    .a11y-dock :global(.theme-toggle) {
      min-height: 2.75rem;
      padding: 0.45rem 0.55rem;
    }

    .a11y-dock__link {
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
    }
  }

  .a11y-dock :global(.theme-toggle__label) {
    display: inline;
    min-width: 0;
    flex: 1 1 auto;
  }

  .a11y-dock :global(.theme-toggle__track) {
    width: 1.55rem;
    height: 0.85rem;
  }

  .a11y-dock :global(.theme-toggle__thumb) {
    width: 0.55rem;
    height: 0.55rem;
  }

  .a11y-dock :global(.theme-toggle[aria-pressed='true'] .theme-toggle__thumb) {
    transform: translateX(0.6rem);
  }
</style>

<script>
  import gsap from 'gsap';

  const prefersReduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePointerMq = () => window.matchMedia('(hover: hover) and (pointer: fine)');
  const isFinePointer = () => finePointerMq().matches;

  function initDock(root: HTMLElement) {
    const hit = root.querySelector<HTMLElement>('[data-a11y-hit]');
    const inner = root.querySelector<HTMLElement>('[data-a11y-inner]');
    const closeBtn = root.querySelector<HTMLButtonElement>('[data-a11y-close]');
    if (!hit || !inner) return;

    let open = false;
    let tween: gsap.core.Tween | null = null;
    let leaveTimer = 0;
    let ignoreOutside = false;
    let ignoreOutsideTimer = 0;
    let collapsed = { w: 48, h: 34 };
    let expanded = { w: 240, h: 180 };

    const syncCloseButton = () => {
      if (!closeBtn) return;
      // Explicit close is for touch/coarse; hover mode uses leave/focusout.
      closeBtn.hidden = isFinePointer();
    };

    const measure = () => {
      const rem = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
      const borderX =
        parseFloat(getComputedStyle(hit).borderLeftWidth) +
        parseFloat(getComputedStyle(hit).borderRightWidth);
      const borderY =
        parseFloat(getComputedStyle(hit).borderTopWidth) +
        parseFloat(getComputedStyle(hit).borderBottomWidth);

      // Match CSS collapsed chip (desktop 3×2.125rem; touch min 2.75rem).
      const touchMin = Math.round(rem * 2.75);
      collapsed = {
        w: Math.round(rem * 3),
        h: Math.round(rem * 2.125),
      };
      if (!isFinePointer()) {
        collapsed.w = Math.max(collapsed.w, touchMin);
        collapsed.h = Math.max(collapsed.h, touchMin);
      }
      expanded = {
        w: Math.ceil(inner.offsetWidth + borderX),
        h: Math.ceil(inner.offsetHeight + borderY),
      };
    };

    const armIgnoreOutside = () => {
      ignoreOutside = true;
      window.clearTimeout(ignoreOutsideTimer);
      // Ignore the opening gesture's bubble / synthetic follow-up outside event.
      ignoreOutsideTimer = window.setTimeout(() => {
        ignoreOutside = false;
      }, 350);
    };

    const applyCollapsedA11y = () => {
      hit.tabIndex = 0;
      hit.setAttribute('role', 'button');
      hit.setAttribute('aria-expanded', 'false');
      inner.setAttribute('inert', '');
      inner.setAttribute('aria-hidden', 'true');
    };

    const applyExpandedA11y = () => {
      // Avoid role=button wrapping interactive controls while open.
      hit.removeAttribute('tabindex');
      hit.removeAttribute('role');
      hit.setAttribute('aria-expanded', 'true');
      inner.removeAttribute('inert');
      inner.removeAttribute('aria-hidden');
    };

    const setClosed = (animate: boolean) => {
      open = false;
      hit.classList.remove('is-open');
      applyCollapsedA11y();
      tween?.kill();
      const seal = () => hit.classList.add('is-sealed');
      if (!animate || prefersReduced()) {
        gsap.set(hit, {
          width: collapsed.w,
          height: collapsed.h,
          overflow: 'hidden',
        });
        seal();
        return;
      }
      tween = gsap.to(hit, {
        width: collapsed.w,
        height: collapsed.h,
        duration: 0.45,
        ease: 'power3.inOut',
        overwrite: true,
        onComplete: seal,
      });
    };

    const setOpen = (animate: boolean) => {
      open = true;
      hit.classList.remove('is-sealed');
      hit.classList.add('is-open');
      const focusChip = document.activeElement === hit;
      applyExpandedA11y();
      if (focusChip) {
        inner.querySelector<HTMLElement>('button, a, [href], [tabindex]:not([tabindex="-1"])')?.focus();
      }
      tween?.kill();
      if (!animate || prefersReduced()) {
        gsap.set(hit, {
          width: expanded.w,
          height: expanded.h,
          overflow: 'hidden',
        });
        return;
      }
      tween = gsap.to(hit, {
        width: expanded.w,
        height: expanded.h,
        duration: 0.55,
        ease: 'power3.out',
        overwrite: true,
      });
    };

    const scheduleClose = () => {
      if (!isFinePointer()) return;
      window.clearTimeout(leaveTimer);
      leaveTimer = window.setTimeout(() => {
        if (hit.contains(document.activeElement)) return;
        setClosed(true);
      }, 160);
    };

    const openFromTouch = () => {
      if (open) return;
      armIgnoreOutside();
      setOpen(true);
    };

    measure();
    syncCloseButton();
    hit.classList.add('is-sealed');
    applyCollapsedA11y();
    gsap.set(hit, {
      width: collapsed.w,
      height: collapsed.h,
      overflow: 'hidden',
    });

    // Fine pointer: hover / focus expand (unchanged behavior).
    hit.addEventListener('pointerenter', () => {
      if (!isFinePointer()) return;
      window.clearTimeout(leaveTimer);
      if (!open) setOpen(true);
    });
    hit.addEventListener('pointerleave', scheduleClose);
    hit.addEventListener('focusin', () => {
      if (!isFinePointer()) return;
      window.clearTimeout(leaveTimer);
      if (!open) setOpen(true);
    });
    hit.addEventListener('focusout', scheduleClose);

    // Touch / coarse: tap chip to toggle; interactive children stay usable.
    hit.addEventListener('click', (event) => {
      if (isFinePointer()) return;

      const target = event.target as Element | null;
      if (!target) return;

      if (target.closest('[data-a11y-close]')) {
        event.preventDefault();
        event.stopPropagation();
        setClosed(true);
        return;
      }

      // Theme toggle, links, and other controls must not collapse the dock.
      if (open && target.closest('button, a, input, select, textarea, [data-theme-toggle]')) {
        return;
      }

      event.preventDefault();
      event.stopPropagation();

      if (open) setClosed(true);
      else openFromTouch();
    });

    hit.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      if (event.target !== hit) return;
      event.preventDefault();
      if (open) setClosed(true);
      else if (isFinePointer()) setOpen(true);
      else openFromTouch();
    });

    closeBtn?.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();
      setClosed(true);
    });

    // Outside tap closes on touch; ignore the same gesture that opened.
    document.addEventListener(
      'pointerdown',
      (event) => {
        if (!open || isFinePointer() || ignoreOutside) return;
        const target = event.target as Node | null;
        if (target && hit.contains(target)) return;
        setClosed(true);
      },
      true,
    );

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !open) return;
      setClosed(true);
      hit.focus();
    });

    const onPointerModeChange = () => {
      syncCloseButton();
      measure();
      window.clearTimeout(leaveTimer);
      gsap.set(hit, {
        width: open ? expanded.w : collapsed.w,
        height: open ? expanded.h : collapsed.h,
      });
    };

    const mq = finePointerMq();
    mq.addEventListener('change', onPointerModeChange);

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        measure();
        gsap.set(hit, {
          width: open ? expanded.w : collapsed.w,
          height: open ? expanded.h : collapsed.h,
        });
      }, 100);
    });
  }

  const start = () => {
    document.querySelectorAll<HTMLElement>('[data-a11y-dock]').forEach(initDock);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start, { once: true });
  } else {
    start();
  }
</script>
