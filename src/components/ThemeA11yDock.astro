---
/**
 * Bottom-left accessibility control. Content stays at full size; GSAP animates
 * a clipping frame (width + height together) on hover / focus.
 */
import ThemeToggle from './ThemeToggle.astro';
---

<aside class="a11y-dock" data-a11y-dock aria-label="Accessibility options">
  <div class="a11y-dock__hit" data-a11y-hit>
    <div class="a11y-dock__inner" data-a11y-inner>
      <p class="a11y-dock__eyebrow mono">A11y</p>
      <div class="a11y-dock__panel">
        <p class="a11y-dock__title">Theme</p>
        <p class="a11y-dock__hint">Switch between redesign and UX4G government look.</p>
        <ThemeToggle />
        <a
          class="a11y-dock__link"
          href="https://www.ux4g.gov.in/?lang=en"
          target="_blank"
          rel="noreferrer"
        >
          UX4G design system ↗
        </a>
      </div>
    </div>
  </div>
</aside>

<style lang="scss">
  @use 'mixins' as *;
  @use 'tokens' as *;
  @use 'sass:map';

  .a11y-dock {
    position: fixed;
    left: max(0.5rem, env(safe-area-inset-left));
    bottom: max(0.5rem, env(safe-area-inset-bottom));
    z-index: map.get($z, 'toast');
  }

  .a11y-dock__hit {
    overflow: hidden;
    box-sizing: border-box;
    border: 1px solid var(--line-strong);
    border-radius: 0.25rem;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    backdrop-filter: blur(10px);
    box-shadow: 0 2px 10px rgb(0 0 0 / 12%);
    // Collapsed fallback before JS measures (eyebrow chip).
    width: 4.25rem;
    height: 2.15rem;
  }

  .a11y-dock__hit.is-open {
    border-color: var(--accent);
    box-shadow: 0 8px 24px rgb(0 0 0 / 18%);
  }

  .a11y-dock__inner {
    box-sizing: border-box;
    width: min(17rem, calc(100vw - 1rem));
    padding: 0.6rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.55rem;
  }

  .a11y-dock__eyebrow {
    margin: 0;
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.2;
    color: var(--ink-3);
    flex: none;
    white-space: nowrap;
  }

  .a11y-dock__panel {
    display: grid;
    gap: 0.55rem;
    width: 100%;
  }

  .a11y-dock__title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .a11y-dock__hint {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--ink-3);
  }

  .a11y-dock__link {
    @include focus-ring(2px);

    font-size: 0.6875rem;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .a11y-dock :global(.theme-toggle) {
    min-width: 0;
    width: 100%;
  }

  .a11y-dock :global(.theme-toggle__label) {
    display: inline;
    min-width: 4.25rem;
  }
</style>

<script>
  import gsap from 'gsap';

  const prefersReduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function initDock(root: HTMLElement) {
    const hit = root.querySelector<HTMLElement>('[data-a11y-hit]');
    const inner = root.querySelector<HTMLElement>('[data-a11y-inner]');
    const eyebrow = root.querySelector<HTMLElement>('.a11y-dock__eyebrow');
    if (!hit || !inner || !eyebrow) return;

    let open = false;
    let tween: gsap.core.Tween | null = null;
    let leaveTimer = 0;
    let collapsed = { w: 68, h: 34 };
    let expanded = { w: 272, h: 200 };

    const measure = () => {
      const innerStyles = getComputedStyle(inner);
      const padX = parseFloat(innerStyles.paddingLeft) + parseFloat(innerStyles.paddingRight);
      const padY = parseFloat(innerStyles.paddingTop) + parseFloat(innerStyles.paddingBottom);
      const borderX =
        parseFloat(getComputedStyle(hit).borderLeftWidth) +
        parseFloat(getComputedStyle(hit).borderRightWidth);
      const borderY =
        parseFloat(getComputedStyle(hit).borderTopWidth) +
        parseFloat(getComputedStyle(hit).borderBottomWidth);

      collapsed = {
        w: Math.ceil(eyebrow.offsetWidth + padX + borderX),
        h: Math.ceil(eyebrow.offsetHeight + padY + borderY),
      };
      expanded = {
        w: Math.ceil(inner.offsetWidth + borderX),
        h: Math.ceil(inner.offsetHeight + borderY),
      };
    };

    const setClosed = (animate: boolean) => {
      open = false;
      hit.classList.remove('is-open');
      tween?.kill();
      if (!animate || prefersReduced()) {
        gsap.set(hit, { width: collapsed.w, height: collapsed.h });
        return;
      }
      tween = gsap.to(hit, {
        width: collapsed.w,
        height: collapsed.h,
        duration: 0.45,
        ease: 'power3.inOut',
        overwrite: true,
      });
    };

    const setOpen = (animate: boolean) => {
      open = true;
      hit.classList.add('is-open');
      tween?.kill();
      if (!animate || prefersReduced()) {
        gsap.set(hit, { width: expanded.w, height: expanded.h });
        return;
      }
      tween = gsap.to(hit, {
        width: expanded.w,
        height: expanded.h,
        duration: 0.55,
        ease: 'power3.out',
        overwrite: true,
      });
    };

    const scheduleClose = () => {
      window.clearTimeout(leaveTimer);
      leaveTimer = window.setTimeout(() => {
        if (hit.contains(document.activeElement)) return;
        setClosed(true);
      }, 160);
    };

    measure();
    gsap.set(hit, { width: collapsed.w, height: collapsed.h });

    hit.addEventListener('pointerenter', () => {
      window.clearTimeout(leaveTimer);
      if (!open) setOpen(true);
    });
    hit.addEventListener('pointerleave', scheduleClose);
    hit.addEventListener('focusin', () => {
      window.clearTimeout(leaveTimer);
      if (!open) setOpen(true);
    });
    hit.addEventListener('focusout', scheduleClose);

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        measure();
        gsap.set(hit, {
          width: open ? expanded.w : collapsed.w,
          height: open ? expanded.h : collapsed.h,
        });
      }, 100);
    });
  }

  const start = () => {
    document.querySelectorAll<HTMLElement>('[data-a11y-dock]').forEach(initDock);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start, { once: true });
  } else {
    start();
  }
</script>
