---
/**
 * Bottom-left accessibility control. Collapsed by default; reveals on hover
 * or keyboard focus so the theme switch stays available without cluttering chrome.
 */
import ThemeToggle from './ThemeToggle.astro';
---

<aside class="a11y-dock" aria-label="Accessibility options">
  <div class="a11y-dock__hit">
    <p class="a11y-dock__eyebrow mono">A11y</p>
    <div class="a11y-dock__panel">
      <p class="a11y-dock__title">Theme</p>
      <p class="a11y-dock__hint">Switch between redesign and UX4G government look.</p>
      <ThemeToggle />
      <a
        class="a11y-dock__link"
        href="https://www.ux4g.gov.in/?lang=en"
        target="_blank"
        rel="noreferrer"
      >
        UX4G design system ↗
      </a>
    </div>
  </div>
</aside>

<style lang="scss">
  @use 'mixins' as *;
  @use 'tokens' as *;
  @use 'sass:map';

  .a11y-dock {
    position: fixed;
    left: max(0.75rem, env(safe-area-inset-left));
    bottom: max(0.75rem, env(safe-area-inset-bottom));
    z-index: map.get($z, 'toast');
    max-width: min(18rem, calc(100vw - 1.5rem));
  }

  .a11y-dock__hit {
    display: grid;
    gap: 0.55rem;
    padding: 0.45rem;
    border: 1px solid var(--line-strong);
    border-radius: 0.25rem;
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    backdrop-filter: blur(12px);
    box-shadow: 0 8px 28px rgb(0 0 0 / 18%);
    transition:
      border-color $dur-fast ease,
      box-shadow $dur-fast ease;
  }

  .a11y-dock__eyebrow {
    margin: 0;
    padding: 0.2rem 0.35rem;
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .a11y-dock__panel {
    display: grid;
    gap: 0.55rem;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    pointer-events: none;
    transform: translateY(0.35rem);
    transition:
      max-height $dur-base $ease-out-quart,
      opacity $dur-fast ease,
      transform $dur-base $ease-out-quart;
  }

  .a11y-dock__title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .a11y-dock__hint {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--ink-3);
  }

  .a11y-dock__link {
    @include focus-ring(2px);

    font-size: 0.6875rem;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  // Reveal on hover / keyboard focus. Always visible when reduced-motion users
  // focus the control; peek tab stays so it remains discoverable.
  .a11y-dock__hit:hover,
  .a11y-dock__hit:focus-within {
    border-color: var(--accent);
    box-shadow: 0 10px 32px rgb(0 0 0 / 22%);

    .a11y-dock__panel {
      max-height: 14rem;
      opacity: 1;
      pointer-events: auto;
      transform: none;
    }
  }

  @include reduced-motion {
    .a11y-dock__panel {
      transition: none;
    }
  }

  // Dock toggle always shows its label.
  .a11y-dock :global(.theme-toggle) {
    min-width: 8.5rem;
    width: 100%;
  }

  .a11y-dock :global(.theme-toggle__label) {
    display: inline;
    min-width: 4.25rem;
  }
</style>
