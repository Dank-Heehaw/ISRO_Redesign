---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
}

const { eyebrow, title, lede } = Astro.props;
---

<header class="page-hero">
  <p class="eyebrow" data-anim="fade-up">{eyebrow}</p>
  <h1 data-anim="split-lines">{title}</h1>
  {lede && <p class="lede" data-anim="fade-up" data-anim-delay="0.1">{lede}</p>}
</header>

<style lang="scss">
  @use 'mixins' as *;

  .page-hero {
    display: grid;
    gap: 1rem;
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--line);
    margin-bottom: clamp(2rem, 4vw, 3.5rem);

    h1 {
      font-size: var(--step-4);
      max-width: 18ch;
    }
  }
</style>
