---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/noto-sans-devanagari/400.css';
import '../styles/global.scss';

import Analytics from '@vercel/analytics/astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeA11yDock from '../components/ThemeA11yDock.astro';
import { withBase } from '../utils/url';

interface Props {
  title: string;
  description: string;
  /** Lets full-bleed heroes sit beneath the transparent fixed header. */
  bleedTop?: boolean;
}

const { title, description, bleedTop = false } = Astro.props;
const fullTitle = title === 'ISRO' ? `${title} (concept redesign)` : `${title} · ISRO redesign`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content="index,follow,max-image-preview:large"
    />
    <meta
      name="author"
      content="Unofficial fan concept redesign — not affiliated with ISRO"
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Press & updates (concept RSS)"
      href={withBase('/rss.xml')}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Missions (concept RSS)"
      href={withBase('/rss/missions.xml')}
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+Display:wght@400;500;600;700&family=Noto+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
    />
    <meta name="theme-color" content="#04060a" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Theme + no-js before first paint: avoid flash of wrong theme / hidden reveals. -->
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
      try {
        if (localStorage.getItem('isro-theme') === 'ux4g') {
          document.documentElement.setAttribute('data-theme', 'ux4g');
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', '#fafafa');
        }
      } catch (e) {}
    </script>
  </head>

  <body class:list={{ 'is-bleed': bleedTop }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ThemeA11yDock />
    <Analytics />

    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>

    <style lang="scss">
      main {
        padding-top: var(--header-h);
      }

      body.is-bleed main {
        padding-top: 0;
      }
    </style>
  </body>
</html>
