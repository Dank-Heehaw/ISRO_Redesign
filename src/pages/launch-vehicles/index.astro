---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import RocketBlueprint from '../../components/brand/RocketBlueprint.astro';
import { withBase } from '../../utils/url';

const vehicles = (await getCollection('vehicles')).sort((a, b) => a.data.order - b.data.order);
const tallest = Math.max(...vehicles.map((v) => v.data.heightM));
---

<BaseLayout
  title="Launch Vehicles"
  description="PSLV, GSLV Mk II, LVM3 and SSLV — India's operational launch fleet, with heights, stages, and payload figures drawn from ISRO's published specs."
>
  <div class="page">
    <div class="page__inner">
      <PageHero
        eyebrow="Launch vehicles"
        title="Four ways to orbit."
        lede="From a smallsat launcher built for quick campaigns to a heavy lifter rated for four-tonne GTO — the operational fleet that carries Indian and commercial payloads."
      />

      <p class="page__intro">
        Specs below follow ISRO's published vehicle pages: height, liftoff mass, stage count, and
        stated LEO / GTO (or sub-GTO) capacity. Exact performance varies by configuration and
        mission design.
      </p>

      <div class="fleet">
        {
          vehicles.map((v) => (
            <article class="vehicle" id={v.id}>
              <div class="vehicle__art" style={`--h: ${(v.data.heightM / tallest) * 100}%`}>
                <RocketBlueprint id={v.id} />
              </div>
              <div class="vehicle__body">
                <h2>{v.data.name}</h2>
                <p class="vehicle__full">{v.data.fullName}</p>
                <p>{v.data.summary}</p>
                <dl>
                  <div>
                    <dt>Height</dt>
                    <dd>{v.data.heightM} m</dd>
                  </div>
                  <div>
                    <dt>Liftoff mass</dt>
                    <dd>{v.data.liftoffMassT === 120 ? '~120 t' : `${v.data.liftoffMassT} t`}</dd>
                  </div>
                  <div>
                    <dt>LEO payload</dt>
                    <dd>{v.data.payloadLeoKg >= 1000 ? `${v.data.payloadLeoKg / 1000} t` : `${v.data.payloadLeoKg} kg`}</dd>
                  </div>
                  <div>
                    <dt>Stages</dt>
                    <dd>{v.data.stages}</dd>
                  </div>
                  <div>
                    <dt>First flight</dt>
                    <dd>{v.data.firstFlight}</dd>
                  </div>
                  <div>
                    <dt>Status</dt>
                    <dd>{v.data.status}</dd>
                  </div>
                  {
                    v.data.payloadGtoKg != null && (
                      <div>
                        <dt>{v.id === 'pslv' ? 'Sub-GTO' : 'GTO payload'}</dt>
                        <dd>{(v.data.payloadGtoKg / 1000).toFixed(2)} t</dd>
                      </div>
                    )
                  }
                </dl>
              </div>
            </article>
          ))
        }
      </div>

      <p class="page__note">
        <a href={withBase('/missions')}>← Back to missions</a>
      </p>
    </div>
  </div>
</BaseLayout>

<style lang="scss">
  @use 'mixins' as *;

  .page {
    padding-bottom: var(--section-y);
  }

  .page__inner {
    @include shell;
  }

  .page__intro {
    max-width: 62ch;
    margin: 0 0 clamp(2rem, 4vw, 3rem);
    color: var(--ink-3);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .fleet {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  .vehicle {
    display: grid;
    gap: 2rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--line);

    @include from('md') {
      grid-template-columns: 8rem 1fr;
      align-items: end;
    }
  }

  .vehicle__art {
    height: clamp(12rem, 28vw, 18rem);
    display: flex;
    align-items: flex-end;
    justify-content: center;

    :global(svg) {
      height: var(--h);
      width: auto;
      max-width: 100%;
    }
  }

  .vehicle__body {
    display: grid;
    gap: 0.75rem;
    color: var(--ink-2);
    line-height: 1.65;

    h2 {
      font-size: var(--step-3);
    }
  }

  .vehicle__full {
    @include eyebrow;
    color: var(--accent);
  }

  dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
    gap: 1rem;
    margin: 0.75rem 0 0;

    dt {
      @include eyebrow;
    }

    dd {
      margin: 0.25rem 0 0;
      font-family: var(--font-mono);
      color: var(--ink);
    }
  }

  .page__note {
    margin-top: 2.5rem;

    a {
      color: var(--accent-lit);
    }
  }
</style>
