---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/url';
---

<BaseLayout title="Page not found" description="This page does not exist in the ISRO redesign concept.">
  <div class="missing">
    <p class="eyebrow">404</p>
    <h1>This page is not on the pad.</h1>
    <p class="lede">The link may be outdated, or the route was never part of this demonstrator.</p>
    <a class="missing__link" href={withBase('/')}>Return home →</a>
  </div>
</BaseLayout>

<style lang="scss">
  @use 'mixins' as *;

  .missing {
    @include shell;
    padding-block: clamp(4rem, 12vw, 8rem);
    display: grid;
    gap: 1rem;
  }

  .missing__link {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-lit);
    width: fit-content;
    border-bottom: 1px solid var(--accent);
  }
</style>
